# Copy to .env and fill in. docker compose reads it automatically.

# Password for the first account, "admin". You'll be asked to change it after signing in.
ADMIN_PASSWORD=change-me

# Servers get addresses like NAME.mc.example.com. Needs a wildcard DNS record (see README).
BASE_DOMAIN=mc.example.com

# Time zone for schedules and logs, e.g. America/Chicago, Europe/London.
TZ=UTC

# Optional: a free CurseForge API key (https://console.curseforge.com) for CurseForge modpacks.
CF_API_KEY=
